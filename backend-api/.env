# ============================================================
# AHARAM BACKEND API — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# Application
APP_ENV=development
APP_NAME=Aharam
APP_URL=http://localhost/aharam/backend-api
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3307
DB_NAME=aharam_db
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=aharam_dev_secret_key_minimum_32_characters_xyz
JWT_EXPIRY=86400
JWT_REFRESH_EXPIRY=604800

# Razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# WhatsApp (Mock)
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_TOKEN=mock_token

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost,https://aharam.in,https://partner.aharam.in,https://delivery.aharam.in,https://admin.aharam.in

# Upload directory
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
