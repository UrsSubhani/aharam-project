        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"customer@test.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"9876543210\",\n  \"role\": \"customer\"\n}" }
          }
        },
        {
          "name": "Login (Customer)",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();\nif (r.success) pm.collectionVariables.set('token', r.data.token);"] } }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@aharam.in\",\n  \"password\": \"Customer@123\"\n}" }
          }
        },
